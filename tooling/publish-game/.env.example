# Copy to tooling/publish-game/.env for a local publish (never commit .env).
# For real publishes these live only in CI secrets (architecture §1, trust boundaries).

# Supabase project URL; its origin is also the CDN origin written into the bundle's CSP.
SUPABASE_URL=https://<project-ref>.supabase.co
# Service-role (secret) key. Never the anon/publishable key; the tool refuses one.
SUPABASE_SERVICE_ROLE_KEY=
# Colyseus URL(s) for the CSP connect-src, comma-separated (http(s) or ws(s)). Optional.
RALLY_COLYSEUS_URL=https://game.<your-domain>   # every endpoint a published build will use (comma-separated); never a LAN address

# pnpm ship / ship:server (tooling/release): the ssh login of the game server box. The deploy URL is RALLY_DEPLOY_URL,
# else the first https entry of RALLY_COLYSEUS_URL.
RALLY_DEPLOY_SSH=root@<box-ip>
