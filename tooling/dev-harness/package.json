{
  "name": "@rally/dev-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Vite plugin that fakes the Rally host bridge so games run in a desktop browser with ready()/session.join()/save/host events working.",
  "type": "module",
  "exports": {
    "./vite": {
      "types": "./src/vite.ts",
      "default": "./src/vite.ts"
    },
    "./harness.iife.js": "./dist/harness.iife.js"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test test/*.test.ts",
    "test:e2e": "node test/e2e.cjs",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@rally/protocol": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
