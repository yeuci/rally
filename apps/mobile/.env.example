# Copy to .env (git-ignored). EXPO_PUBLIC_* values are inlined into the JS bundle: never put secrets here.

# Supabase project (Dashboard → Project Settings → API). The anon key is public by design; RLS bounds what it can do.
# Local stack: `supabase start` prints both (URL is usually http://<LAN IP>:54321 so a phone can reach it).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Colyseus HTTP base URL (no trailing slash). Dev: your LAN IP while `pnpm dev:server` runs. Cloud: https://<app>.colyseus.cloud
EXPO_PUBLIC_COLYSEUS_URL=http://192.168.1.10:2567

# Developer launcher default bundle (M0 spike). Dev: your machine's LAN IP while `pnpm dev:spike` (vite --host) runs.
EXPO_PUBLIC_SPIKE_BUNDLE_URL=http://192.168.1.10:5180/index.html

# Optional. "1" shows the Developer launcher in non-__DEV__ builds (internal preview builds for device measurements).
EXPO_PUBLIC_DEV_TOOLS=0

# Optional. "1" turns on shake to report a bug (and Settings → Developer) in non-__DEV__ builds: playtest builds.
# Always on in dev; leave it unset for store builds. See docs/bug-reports.md.
EXPO_PUBLIC_BUG_REPORTS=0

# Where "Delete account" and support links point.
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
