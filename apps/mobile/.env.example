# Copy to .env (git-ignored). EXPO_PUBLIC_* values are inlined into the JS bundle.

# Where the spike bundle is served from. Production: the Supabase Storage public URL of games/spike/<version>/index.html.
# Dev: your machine's LAN IP while `pnpm spike` (vite --host) runs.
EXPO_PUBLIC_SPIKE_BUNDLE_URL=http://192.168.1.10:5173/index.html

# Colyseus HTTP base URL (no trailing slash). Dev: your LAN IP while `pnpm server` runs. Cloud: https://<app>.colyseus.cloud
EXPO_PUBLIC_COLYSEUS_URL=http://192.168.1.10:2567
