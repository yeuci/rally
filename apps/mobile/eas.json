{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "EXPO_PUBLIC_COLYSEUS_URL": "http://192.168.1.10:2567" },
      "ios": { "simulator": false },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "EXPO_PUBLIC_COLYSEUS_URL": "https://game.<your-domain>", "EXPO_PUBLIC_BUG_REPORTS": "1" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": { "EXPO_PUBLIC_COLYSEUS_URL": "https://game.<your-domain>" }
    }
  },
  "submit": {
    "production": {}
  }
}
