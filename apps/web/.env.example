# @rally/web build configuration. Copy to apps/web/.env for local builds (variables already set in the
# environment win), or set these in the static host's build settings. Unset values fall back to
# placeholders with a loud warning; build with `pnpm build --strict` (or WEB_STRICT=1) to fail instead.

# The associated domain, exactly as in the app's entitlement (applinks:<host>) and Android intent filter.
# https only, no path, no trailing slash. Apple fetches https://<host>/.well-known/apple-app-site-association.
SITE_ORIGIN=https://rally.app

# Apple Developer Team ID (10 chars, developer.apple.com → Membership details). AASA appID = <TEAM_ID>.app.rally.mobile
APPLE_TEAM_ID=

# SHA-256 fingerprints of every certificate that signs the Android app, comma-separated (AA:BB:… or bare hex):
#  - Play App Signing key: Play Console → Test and release → App integrity → App signing key certificate
#  - EAS upload/local keystore: `eas credentials -p android` (needed for internal / sideloaded builds)
ANDROID_SHA256_FINGERPRINTS=

# Numeric App Store ID (App Store Connect → App Information → Apple ID). Enables the Safari Smart App Banner
# and, if IOS_APP_STORE_URL is unset, derives https://apps.apple.com/app/id<IOS_APP_ID>.
IOS_APP_ID=

# Store listing URLs for the "Download" buttons and the "app not installed" fallback.
IOS_APP_STORE_URL=
# Defaults to https://play.google.com/store/apps/details?id=app.rally.mobile
ANDROID_PLAY_URL=

# Optional live catalog: with both set, published games come from the Supabase `games` table (anon key,
# public read via RLS) instead of games/*/game.json. Never use the service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 1 = fail the build on any placeholder/config warning (recommended for production deploys).
WEB_STRICT=

# Dev server (`pnpm dev` / `pnpm serve`) port; default 5190.
PORT=
