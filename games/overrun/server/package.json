{
  "name": "@rally/game-overrun-server",
  "version": "0.1.0",
  "private": true,
  "description": "Overrun's engine-free rules: arena, flow-field zombie navigation, hitscan weapons, explosives, waves, revives and results. Runs authoritatively inside apps/game-server's OverrunRoom and in the client for prediction of the local player's movement.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "rally-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test test/*.test.ts",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3"
  }
}
