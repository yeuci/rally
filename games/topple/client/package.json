{
  "name": "@rally/game-topple",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test test/*.test.ts",
    "test:e2e": "node test/e2e.cjs",
    "models": "node --experimental-strip-types --no-warnings=ExperimentalWarning ../scripts/models.ts",
    "art": "node --experimental-strip-types --no-warnings=ExperimentalWarning ../scripts/art.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "0.21.0",
    "@rally/game-kit": "workspace:*",
    "@rally/sdk": "workspace:*",
    "playcanvas": "^2.23.3"
  },
  "devDependencies": {
    "@rally/dev-harness": "workspace:*",
    "@rally/model-pipeline": "workspace:*",
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
