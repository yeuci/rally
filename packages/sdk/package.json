{
  "name": "@rally/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Rally SDK \u2014 typed bridge client that runs inside a game's WebView and talks to the Rally shell.",
  "type": "module",
  "main": "./dist/rally-sdk.js",
  "module": "./dist/rally-sdk.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/rally-sdk.js",
      "default": "./dist/rally-sdk.js"
    },
    "./iife": "./dist/rally-sdk.iife.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test test/*.test.ts",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@rally/protocol": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
