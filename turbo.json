{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "@rally/publish-game#test": {
      "dependsOn": [
        "^build",
        "@rally/game-spike#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/games/spike/game.json",
        "$TURBO_ROOT$/games/spike/art/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@rally/game-sumo#typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../scripts/**"
      ]
    },
    "@rally/game-sumo#lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../scripts/**"
      ]
    },
    "@rally/game-overrun#typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../scripts/**"
      ]
    },
    "@rally/game-overrun#lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../scripts/**"
      ]
    },
    "@rally/game-gunrun#typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../scripts/**"
      ]
    },
    "@rally/game-gunrun#lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../scripts/**"
      ]
    },
    "@rally/game-sushi#typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../scripts/**"
      ]
    },
    "@rally/game-sushi#lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../scripts/**"
      ]
    }
  }
}
