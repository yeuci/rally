# Template for /etc/rally/game-server.env on the game-server box (ADR 0006). NO VALUES ARE COMMITTED.
# provision.sh copies this file there once (root:rally, mode 0640) and never overwrites it; fill it in on the box:
#   sudoedit /etc/rally/game-server.env
# deploy.sh parses it (KEY=value per line, no shell expansion; optional surrounding quotes are stripped) and starts
# pm2 with exactly these variables plus HOME/PATH/LANG/USER. An empty value counts as unset. Re-run deploy.sh after editing.
# Reference for every variable: apps/game-server/README.md, "Environment".

# Required. Supabase project URL (https://<project-ref>.supabase.co). JWKS for token verification is fetched from it.
SUPABASE_URL=
# Required with SUPABASE_URL. The public anon / publishable key (same value as the app's EXPO_PUBLIC_SUPABASE_ANON_KEY).
SUPABASE_ANON_KEY=
# Required with SUPABASE_URL in production (the server refuses to start without it). SECRET: sb_secret_... key or
# the legacy service_role JWT. Only this file, CI and Edge Functions ever hold it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Mounts /monitor and the playground (they can list and dispose rooms) behind HTTP basic auth. Empty: not
# mounted at all. To keep them off the internet, also uncomment the @monitor block in the Caddyfile and use
# ssh -L 2567:127.0.0.1:2567 <box>, then http://localhost:2567/monitor.
RALLY_MONITOR_PASSWORD=

# Optional, legacy projects only: HS256 JWT secret.
SUPABASE_JWT_SECRET=
# Optional. Origins allowed by CORS (comma-separated). The app's native fetch needs none; leave empty.
RALLY_CORS_ORIGINS=

# Do not set here: NODE_ENV (ecosystem.config.cjs sets production), PORT (Caddy proxies to 2567),
# RALLY_DEV_RULES (deploy.sh refuses 1), RALLY_ALLOW_GUESTS (production refuses guests; 1 admits anyone unsigned).
